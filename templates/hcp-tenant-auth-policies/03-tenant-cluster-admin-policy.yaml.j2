apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: {{ hcp_tenant_cluster_admin_policy_name }}
  namespace: {{ hcp_tenant_policy_namespace }}
  annotations:
    policy.open-cluster-management.io/standards: HCP tenant access
    policy.open-cluster-management.io/categories: RBAC
    policy.open-cluster-management.io/controls: HCP tenant cluster-admin user
spec:
  remediationAction: {{ hcp_tenant_policy_remediation_action }}
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: {{ hcp_tenant_cluster_admin_policy_name }}
        spec:
          remediationAction: {{ hcp_tenant_policy_remediation_action }}
          severity: high
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: rbac.authorization.k8s.io/v1
                kind: ClusterRoleBinding
                metadata:
                  name: {{ hcp_tenant_cluster_admin_binding_name }}
                roleRef:
                  apiGroup: rbac.authorization.k8s.io
                  kind: ClusterRole
                  name: cluster-admin
                subjects:
                  - apiGroup: rbac.authorization.k8s.io
                    kind: User
                    name: {{ hcp_tenant_admin_username }}
