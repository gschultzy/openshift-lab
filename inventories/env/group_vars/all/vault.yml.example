---
# Copy this example to vault.yml, replace the CHANGE_ME values, and encrypt it.
#
#   cp inventories/env/group_vars/all/vault.yml.example inventories/env/group_vars/all/vault.yml
#   ansible-vault encrypt inventories/env/group_vars/all/vault.yml
#
# Non-secret environment settings belong in main.yml. Secrets belong only in
# the encrypted vault.yml file.

vault_vcenter_password: "CHANGE_ME"
vault_esxi_password: "CHANGE_ME"

# Paste your full Red Hat pull secret JSON as a single-line string.
vault_pull_secret: '{"auths":{}}'

# SSH public key injected into the cluster nodes.
vault_ssh_public_key: "ssh-ed25519 CHANGE_ME administrator@ENV-BASTION"

# Optional, only needed for AD DNS automation over WinRM.
vault_ad_username: "POC\\administrator"
vault_ad_password: "CHANGE_ME"

# iDRAC credentials for Redfish virtual media automation.
vault_idrac_username: "pureuser"
vault_idrac_password: "CHANGE_ME"

# Dedicated Pure FlashArray credentials for Portworx.
# Store passwords/tokens only in this encrypted Vault file. The token-generation
# script writes generated API tokens under build/pure/ with mode 0600.
vault_site_a_pure_flasharray_password: "CHANGE_ME_SITE_A_FLASHARRAY_PASSWORD"
vault_site_a_pure_flasharray_api_token: ""
vault_site_b_pure_flasharray_password: "CHANGE_ME_SITE_B_FLASHARRAY_PASSWORD"
vault_site_b_pure_flasharray_api_token: ""

# Legacy aliases are still accepted by main.yml during migration:
# vault_pure_flasharray_password / vault_pure_flasharray_api_token       -> Site-A
# vault_pure_flasharray_secondary_password / secondary_api_token         -> Site-B


# Shared lab administrator. These override the Pod 74 lab defaults in main.yml.
# Use a unique password outside this isolated lab.
vault_cluster_admin_username: "admin"
vault_cluster_admin_password: "Password1!"
