{% if portworx_pure_apply_storagecluster | default(true) | bool %}
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: portworx-pure-secret
  namespace: {{ portworx_pure_policy_namespace }}
  annotations:
    policy.open-cluster-management.io/standards: Portworx Pure FlashArray
    policy.open-cluster-management.io/categories: Credentials
    policy.open-cluster-management.io/controls: px-pure-secret
spec:
  remediationAction: {{ portworx_pure_policy_remediation_action }}
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: portworx-pure-secret
        spec:
          remediationAction: {{ portworx_pure_policy_remediation_action }}
          severity: high
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: Namespace
                metadata:
                  name: {{ portworx_namespace }}
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: Secret
                metadata:
                  name: px-pure-secret
                  namespace: {{ portworx_namespace }}
                type: Opaque
                stringData:
                  pure.json: |
                    {
                      "FlashArrays": [
                        {
                          "MgmtEndPoint": "{{ pure_flasharray_mgmt_endpoint }}",
                          "APIToken": "{{ pure_flasharray_api_token }}"{% if pure_flasharray_realm | default('') | length > 0 %},
                          "Realm": "{{ pure_flasharray_realm }}"{% endif %}
                        }
                      ]
                    }
{% endif %}
