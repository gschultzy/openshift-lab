apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: {{ hcp_tenant_site_a_oauth_policy_name }}
  namespace: {{ hcp_tenant_policy_namespace }}
  annotations:
    policy.open-cluster-management.io/standards: HCP tenant access
    policy.open-cluster-management.io/categories: Authentication
    policy.open-cluster-management.io/controls: Site-A HostedCluster HTPasswd OAuth
spec:
  remediationAction: {{ hcp_tenant_policy_remediation_action }}
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: {{ hcp_tenant_site_a_oauth_policy_name }}
        spec:
          remediationAction: {{ hcp_tenant_policy_remediation_action }}
          severity: high
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: Secret
                metadata:
                  name: {{ site_a_hcp_htpasswd_secret_name }}
                  namespace: {{ site_a_hcp_namespace }}
                type: Opaque
                data:
                  htpasswd: '{% raw %}{{hub fromSecret "{% endraw %}{{ lab_admin_policy_namespace }}{% raw %}" "{% endraw %}{{ lab_admin_source_secret_name }}{% raw %}" "htpasswd" hub}}{% endraw %}'
{% for tenant in hcp_tenants | selectattr('site', 'equalto', 'site-a') | list %}
            - complianceType: musthave
              objectDefinition:
                apiVersion: hypershift.openshift.io/v1beta1
                kind: HostedCluster
                metadata:
                  name: {{ tenant.name }}
                  namespace: {{ site_a_hcp_namespace }}
                spec:
                  configuration:
                    oauth:
                      identityProviders:
                        - name: {{ hcp_tenant_htpasswd_idp_name }}
                          mappingMethod: claim
                          type: HTPasswd
                          htpasswd:
                            fileData:
                              name: {{ site_a_hcp_htpasswd_secret_name }}
{% endfor %}
