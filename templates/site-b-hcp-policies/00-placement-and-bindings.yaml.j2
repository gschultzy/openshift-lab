apiVersion: v1
kind: Namespace
metadata:
  name: {{ site_b_policy_namespace }}
---
apiVersion: cluster.open-cluster-management.io/v1beta2
kind: ManagedClusterSetBinding
metadata:
  name: {{ site_b_clusterset }}
  namespace: {{ site_b_policy_namespace }}
spec:
  clusterSet: {{ site_b_clusterset }}
---
apiVersion: cluster.open-cluster-management.io/v1beta1
kind: Placement
metadata:
  name: {{ site_b_policy_placement_name }}
  namespace: {{ site_b_policy_namespace }}
spec:
{% if site_b_policy_tolerate_unreachable | default(false) | bool %}
  tolerations:
    - key: cluster.open-cluster-management.io/unreachable
      operator: Exists
      effect: NoSelect
    - key: cluster.open-cluster-management.io/unavailable
      operator: Exists
      effect: NoSelect
{% endif %}
  predicates:
    - requiredClusterSelector:
        labelSelector:
          matchLabels:
            {{ site_b_policy_cluster_label_key }}: "{{ site_b_policy_cluster_label_value }}"
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: site-b-hcp-prereqs-binding
  namespace: {{ site_b_policy_namespace }}
placementRef:
  apiGroup: cluster.open-cluster-management.io
  kind: Placement
  name: {{ site_b_policy_placement_name }}
subjects:
  - apiGroup: policy.open-cluster-management.io
    kind: Policy
    name: site-b-openshift-virtualization
  - apiGroup: policy.open-cluster-management.io
    kind: Policy
    name: site-b-metallb-hcp
  - apiGroup: policy.open-cluster-management.io
    kind: Policy
    name: site-b-ingress-wildcards
{% if nmstate_enabled | default(true) | bool %}
  - apiGroup: policy.open-cluster-management.io
    kind: Policy
    name: site-b-nmstate-operator
  - apiGroup: policy.open-cluster-management.io
    kind: Policy
    name: site-b-nmstate-instance
{% endif %}
{% if site_b_lvm_policy_enabled | default(false) | bool %}
  - apiGroup: policy.open-cluster-management.io
    kind: Policy
    name: site-b-lvm-storage
{% endif %}
