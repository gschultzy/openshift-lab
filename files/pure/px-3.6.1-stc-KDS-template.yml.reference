# SOURCE: https://install.portworx.com/3.6?operator=true&mc=false&kbver=1.31.0&ns=portworx&b=true&kvdbtls=true&certmgr=true&iop=6&s=%22size%3D2000%22&j=size%3D3&pureSanType=FC&ce=pure&dmthin=true&r=17001&c=px-cluster-eb3d29ae-abcb-4581-90bd-4164cc3cbe23&osft=true&stork=true&csi=true&mon=true&aut=false&tel=true&st=k8s
# NOTE: The downloaded template had two cloudStorage keys. This reference keeps the
# same settings but normalizes them into a single cloudStorage block so YAML parsers
# do not drop either provider or device/journal settings.
kind: StorageCluster
apiVersion: core.libopenstorage.org/v1
metadata:
  name: px-cluster-flasharray
  namespace: portworx
  annotations:
    portworx.io/install-source: "https://install.portworx.com/3.6?operator=true&mc=false&kbver=1.31.0&ns=portworx&b=true&kvdbtls=true&certmgr=true&iop=6&s=%22size%3D2000%22&j=size%3D3&pureSanType=FC&ce=pure&dmthin=true&r=17001&c=px-cluster-eb3d29ae-abcb-4581-90bd-4164cc3cbe23&osft=true&stork=true&csi=true&mon=true&aut=false&tel=true&st=k8s"
    portworx.io/is-openshift: "true"
    portworx.io/misc-args: " -T px-storev2 "
    portworx.io/preflight-check: "true"
spec:
  image: docker.io/portworx/oci-monitor:3.6.1.1
  imagePullPolicy: Always
  kvdb:
    internal: true
    enableTLS: true
  cloudStorage:
    provider: pure
    deviceSpecs:
    - size=2000
    journalDeviceSpec: size=3
  secretsProvider: k8s
  startPort: 17001
  stork:
    enabled: true
    args:
      webhook-controller: "true"
  runtimeOptions:
    default-io-profile: "6"
  csi:
    enabled: true
  monitoring:
    telemetry:
      enabled: true
    prometheus:
      exportMetrics: true
  certManager:
    enabled: true
  kubeDatastore:
    enableDynamicPools: true
  env:
  - name: PURE_FLASHARRAY_SAN_TYPE
    value: "FC"
